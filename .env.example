# =============================================================================
# newreserve — server-side env vars
#
# Only NEW vars introduced by the Loop → Shopify Subscriptions scaffolding PR
# are documented here. This file is intentionally partial. Existing vars are
# still consulted from Vercel and code as before.
# =============================================================================

# -- Loop → Shopify Subscriptions scaffolding -----------------------------------

# Feature flag that gates the new /api/subscription/* routes. Until this is set
# to "shopify" in Vercel, every action on /api/subscription/[action] returns 404
# and the existing /api/loop/subscription/* routes continue to serve /account.
#
# Values: "loop" (default) | "shopify"
SUBSCRIPTIONS_BACKEND=loop

# Access token for the NEW Partner-Dashboard-registered custom app
# (`mully-subscriptions-api` or similar). This app owns subscription contracts
# and holds the protected subscription scopes; the existing SHOPIFY_ADMIN_TOKEN
# custom app CANNOT be granted those scopes and cannot mutate contracts.
#
# Required by src/app/api/_lib/shopifySubscriptionsApi.ts.
SHOPIFY_SUBSCRIPTIONS_TOKEN=

# HMAC secret for verifying webhooks from the new Partner app on
# /api/subscription/webhook. Distinct from SHOPIFY_WEBHOOK_SECRET, which
# belongs to the existing admin-installed custom app.
SHOPIFY_SUBSCRIPTIONS_WEBHOOK_SECRET=
