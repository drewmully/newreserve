rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── users ──────────────────────────────────────────────────────────────
    // Owner-only read/create/update. Delete is never allowed.
    match /users/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;
    }

    // ── registry_applications ───────────────────────────────────────────────
    // The registry application is user-owned but approval state is server-managed.
    // Clients can create and edit only their own "pending" application metadata.
    // Status must stay "pending" from the client side.
    match /registry_applications/{applicationId} {
      allow create: if request.auth != null
        && applicationId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "user_id",
          "status",
          "created_at",
          "metadata"
        ])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.metadata is map
        && request.resource.data.created_at == request.time;

      allow read: if request.auth != null
        && request.auth.uid == applicationId;

      allow update: if request.auth != null
        && request.auth.uid == applicationId
        && resource.data.status == "pending"
        && request.resource.data.keys().hasOnly([
          "user_id",
          "status",
          "created_at",
          "metadata"
        ])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.metadata is map
        && request.resource.data.created_at == resource.data.created_at;

      allow delete: if false;
    }

    // ── default deny ────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
