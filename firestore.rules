rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // users
    // Sensitive fields are server-managed after account creation.
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          "email",
          "created_at",
          "last_login",
          "updated_at",
          "shopify_customer_id",
          "store_credit",
          "subscriptions",
          "cart",
          "segments",
          "messaging_preferences",
          "username",
          "onboarding_completed",
          "onboarding_profile",
          "fit_profile"
        ])
        && request.resource.data.email is string
        && request.resource.data.created_at == request.time
        && request.resource.data.last_login == request.time
        && request.resource.data.updated_at == request.time
        && request.resource.data.username is string
        && request.resource.data.onboarding_completed is bool
        && request.resource.data.shopify_customer_id == null
        && request.resource.data.store_credit is map
        && request.resource.data.store_credit.balance_cents == 0
        && request.resource.data.store_credit.currency == "USD"
        && request.resource.data.store_credit.last_synced == null
        && request.resource.data.subscriptions is map
        && request.resource.data.subscriptions.mullybox_active == false
        && request.resource.data.subscriptions.status == "none"
        && request.resource.data.subscriptions.total_subscription_count == 0
        && request.resource.data.subscriptions.active_subscription_ids is list
        && request.resource.data.subscriptions.active_subscription_ids.size() == 0
        && request.resource.data.subscriptions.manage_url == null
        && request.resource.data.subscriptions.next_unblock_url == null
        && request.resource.data.subscriptions.last_checked == null
        && request.resource.data.cart is map
        && request.resource.data.cart.cart_id == null
        && request.resource.data.cart.updated_at == null
        && request.resource.data.segments is list
        && request.resource.data.segments.size() == 0
        && request.resource.data.messaging_preferences is map
        && request.resource.data.messaging_preferences.email_marketing is bool
        && request.resource.data.messaging_preferences.sms_marketing is bool
        && request.resource.data.messaging_preferences.push_notifications is bool
        && (
          !request.resource.data.keys().hasAny(["onboarding_profile"])
          || request.resource.data.onboarding_profile is map
        )
        && (
          !request.resource.data.keys().hasAny(["fit_profile"])
          || request.resource.data.fit_profile is map
        );

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "email",
          "last_login",
          "updated_at",
          "username",
          "onboarding_completed",
          "onboarding_profile",
          "onboarding_profile.birth_month",
          "onboarding_profile.birth_day",
          "onboarding_profile.birth_year",
          "onboarding_profile.birthdate_iso",
          "onboarding_profile.handicap",
          "onboarding_profile.private_club_member",
          "onboarding_profile.club_name",
          "onboarding_profile.vibe_check",
          "onboarding_profile.selected_tier",
          "fit_profile",
          "messaging_preferences",
          "messaging_preferences.email_marketing",
          "messaging_preferences.sms_marketing",
          "messaging_preferences.push_notifications",
          "cart",
          "cart.cart_id",
          "cart.updated_at",
          "tier",
          "isLegacy",
          "legacyPlan",
          "back9WelcomeSeen",
          "phone_e164",
          "sms_consent_given_at"
        ])
        // get(..., null): server-created docs (start-account, orders-paid,
        // Loop provisioning) may lack these fields. A bare field read on a
        // missing key is an error, which denied every client update to those
        // docs (including syncUserProfile's last_login write). The values
        // still cannot be changed or added by the client.
        && request.resource.data.get("created_at", null) == resource.data.get("created_at", null)
        && request.resource.data.get("shopify_customer_id", null) == resource.data.get("shopify_customer_id", null)
        && (
          request.resource.data.get("email", null) == resource.data.get("email", null)
          || (
            request.auth.token.email != null
            && request.resource.data.email is string
            && request.resource.data.email.lower() == request.auth.token.email.lower()
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["username"])
          || request.resource.data.username is string
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["onboarding_completed"])
          || request.resource.data.onboarding_completed is bool
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["messaging_preferences"])
          || request.resource.data.messaging_preferences is map
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["cart"])
          || request.resource.data.cart is map
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["fit_profile"])
          || request.resource.data.fit_profile is map
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["onboarding_profile"])
          || request.resource.data.onboarding_profile is map
        )
        // Onboarding phone: E.164 only.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["phone_e164"])
          || (
            request.resource.data.phone_e164 is string
            && request.resource.data.phone_e164.matches('^[+][1-9][0-9]{6,14}$')
          )
        )
        // SMS consent record: server time of this write, only alongside a
        // valid phone and sms_marketing=true. Cannot be backdated or removed.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["sms_consent_given_at"])
          || (
            request.resource.data.sms_consent_given_at is timestamp
            && request.resource.data.sms_consent_given_at == request.time
            && request.resource.data.get("phone_e164", null) is string
            && request.resource.data.get("messaging_preferences", {}).get("sms_marketing", false) == true
          )
        );

      allow delete: if false;
    }

    // registry_applications
    // User-owned draft document; approval status is server-managed.
    match /registry_applications/{applicationId} {
      allow create: if request.auth != null
        && applicationId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "user_id",
          "status",
          "created_at",
          "metadata"
        ])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.metadata is map
        && request.resource.data.created_at == request.time;

      allow read: if request.auth != null
        && request.auth.uid == applicationId;

      allow update: if request.auth != null
        && request.auth.uid == applicationId
        && resource.data.status == "pending"
        && request.resource.data.keys().hasOnly([
          "user_id",
          "status",
          "created_at",
          "metadata"
        ])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.metadata is map
        && request.resource.data.created_at == resource.data.created_at;

      allow delete: if false;
    }

    // default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
